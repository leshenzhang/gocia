@SET PROJ sc
@SET CHG 0
@SET NEX 0.0
@SET LPB 3.04
@SET NC 0.0025
@SET ADDMOS 80
# Route C: single point at fixed charge with the implicit electrolyte, one run per charge (5-point parabola).
# CHG = integer &DFT CHARGE. Fractional excess electrons: set NEX and uncomment the &GCE block
# (NELECTRON_EXCESS with MAX_OUTER_UPDATES 0 = constant-charge run).
# Parse: gocia.utils.cp2k.collect_surfChrg -> sc.dat -> get_parabola -> parabola.dat
&GLOBAL
  PROJECT ${PROJ}
  PRINT_LEVEL LOW
  RUN_TYPE ENERGY
  EXTENDED_FFT_LENGTHS
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    CHARGE ${CHG}
    &QS
      EPS_DEFAULT 1.0E-10
      EXTRAPOLATION ASPC
      EXTRAPOLATION_ORDER 3
    &END QS
    &POISSON
      PERIODIC XYZ
      PSOLVER PERIODIC
    &END POISSON
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          PARAMETER_FILE_NAME dftd3.dat
          TYPE DFTD3(BJ)
          REFERENCE_FUNCTIONAL PBE
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
    &MGRID
      CUTOFF 500
      REL_CUTOFF 50
    &END MGRID
    &SCCS on
      ALPHA [N*m^-1] 0.0
      BETA [kbar] 0.0
      GAMMA [mN/m] 0.0
      DELTA_RHO 2.0E-5
      DERIVATIVE_METHOD fft
      DIELECTRIC_CONSTANT 78.4
      EPS_SCCS 1.0E-6
      EPS_SCF 0.5
      MAX_ITER 200
      METHOD ISODENSITY
      MIXING 0.6
      SOLVER NEWTON_CG
      EPS_NLPB 1.0E-9
      MAX_ITER_NLPB 50
      DEBYE_LENGTH [angstrom] ${LPB}
      &ISODENSITY
        RHO_CAVITY [angstrom^-3] ${NC}
        SWITCH_WIDTH 0.6
      &END ISODENSITY
    &END SCCS
    &SCF
      MAX_SCF 400
      EPS_SCF 1.0E-6
      SCF_GUESS atomic
      ADDED_MOS ${ADDMOS}
      &DIAGONALIZATION on
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &SMEAR on
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.2
        NBROYDEN 8
      &END MIXING
#      &GCE on
#        NELECTRON_EXCESS ${NEX}
#        MAX_OUTER_UPDATES 0
#      &END GCE
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
  &END DFT
  &SUBSYS
    &CELL
      @INCLUDE cell.inc
      PERIODIC XYZ
    &END CELL
    &COORD
      @INCLUDE coord.inc
    &END COORD
    @INCLUDE kind.inc
  &END SUBSYS
&END FORCE_EVAL
