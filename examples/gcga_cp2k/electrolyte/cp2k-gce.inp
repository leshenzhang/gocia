# Route B: GEO_OPT at constant potential USHE (V vs SHE); needs the cp2k-implicit-electrolyte build.
# Omega_el = E - E_F*N_e from the last "GCE| trace" line. Slab must be z-symmetrised.
@SET PROJ gce
@SET CHG 0
@SET MULT 1
@SET ADDMOS 81
@SET USHE 0.0
@SET PHISHE 4.43
@SET LPB 3.04
@SET NC 0.0025
&GLOBAL
  PROJECT ${PROJ}
  RUN_TYPE GEO_OPT
  PRINT_LEVEL LOW
&END GLOBAL
&MOTION
  &GEO_OPT
    OPTIMIZER BFGS
    MAX_ITER 300
    MAX_FORCE 1.945E-03
    RMS_FORCE 1.945E-03
    MAX_DR 1
    RMS_DR 1
    &BFGS
      &RESTART OFF
      &END RESTART
    &END BFGS
  &END GEO_OPT
  &CONSTRAINT
    @INCLUDE constraint.inc
  &END CONSTRAINT
  &PRINT
    &TRAJECTORY OFF
    &END TRAJECTORY
    &FINAL_STRUCTURE
      PRINT_CIF F
    &END FINAL_STRUCTURE
    &RESTART OFF
    &END RESTART
    &RESTART_HISTORY OFF
    &END RESTART_HISTORY
  &END PRINT
&END MOTION
&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    CHARGE ${CHG}
@IF ${MULT} == 2
    UKS
    MULTIPLICITY 2
@ENDIF
    &QS
      EPS_DEFAULT 1.0E-11
    &END QS
    &MGRID
      CUTOFF 350
      REL_CUTOFF 50
    &END MGRID
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &SCCS
      ALPHA [N*m^-1] 0.0
      BETA [kbar] 0.0
      GAMMA [mN/m] 0.0
      DIELECTRIC_CONSTANT 78.4
      METHOD ISODENSITY
      SOLVER NEWTON_CG
      DEBYE_LENGTH [angstrom] ${LPB}
      &ISODENSITY
        RHO_CAVITY [angstrom^-3] ${NC}
      &END ISODENSITY
    &END SCCS
    &SCF
      MAX_SCF 600
      EPS_SCF 5.0E-6
      ADDED_MOS ${ADDMOS}
      &DIAGONALIZATION
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.4
        NBROYDEN 8
      &END MIXING
      &SMEAR
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE 300
      &END SMEAR
      &GCE
        UPDATE_SCHEME CAPACITANCE
        UPDATE_EVERY SCF_CYCLE
        TARGET_POTENTIAL [eV] ${USHE}
        PHI_SHE [eV] ${PHISHE}
      &END GCE
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
  &END DFT
  &SUBSYS
    &CELL
      @INCLUDE cell.inc
    &END CELL
    &COORD
      @INCLUDE coord.inc
    &END COORD
    @INCLUDE kind.inc
  &END SUBSYS
&END FORCE_EVAL
