# Stage 2/3: force < 0.2 eV/A, 350/50 Ry, EPS_SCF 1e-4 (docs/SPEED_TUNING.md: 0.09 meV, 3e-4 A vs 1e-5), Kerker BETA 1.5;
# restarts from stage1-RESTART.wfn (atomic guess automatically if atoms were removed), writes stage2-RESTART.wfn
@SET PROJ stage2
@SET CHG 0
@SET MULT 1
@SET ADDMOS 81
&GLOBAL
  PREFERRED_DIAG_LIBRARY ELPA
  ELPA_KERNEL AUTO
  PROJECT ${PROJ}
  RUN_TYPE GEO_OPT
  PRINT_LEVEL LOW
&END GLOBAL
&MOTION
  &GEO_OPT
    OPTIMIZER BFGS
    MAX_ITER 300
    MAX_FORCE 3.889E-03
    RMS_FORCE 3.889E-03
    MAX_DR 1
    RMS_DR 1
    &BFGS
      &RESTART OFF
      &END RESTART
    &END BFGS
  &END GEO_OPT
  &CONSTRAINT
    @INCLUDE constraint.inc
  &END CONSTRAINT
  &PRINT
    &TRAJECTORY OFF
    &END TRAJECTORY
    &FINAL_STRUCTURE
      PRINT_CIF F
    &END FINAL_STRUCTURE
    &RESTART OFF
    &END RESTART
    &RESTART_HISTORY OFF
    &END RESTART_HISTORY
  &END PRINT
&END MOTION
&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    WFN_RESTART_FILE_NAME stage1-RESTART.wfn
    CHARGE ${CHG}
@IF ${MULT} == 2
    UKS
    MULTIPLICITY 2
@ENDIF
    &QS
      EPS_DEFAULT 1.0E-11
    &END QS
    &MGRID
      CUTOFF 350
      REL_CUTOFF 50
    &END MGRID
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &SCF
      MAX_SCF 128
      EPS_SCF 1.0E-4
      SCF_GUESS RESTART
      ADDED_MOS ${ADDMOS}
      &DIAGONALIZATION
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.4
        NBROYDEN 8
        BETA 1.5
      &END MIXING
      &SMEAR
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE 300
      &END SMEAR
      &PRINT
        &RESTART
          BACKUP_COPIES 0
        &END RESTART
      &END PRINT
    &END SCF
  &END DFT
  &SUBSYS
    &CELL
      @INCLUDE cell.inc
    &END CELL
    &COORD
      @INCLUDE coord.inc
    &END COORD
    @INCLUDE kind.inc
  &END SUBSYS
&END FORCE_EVAL
