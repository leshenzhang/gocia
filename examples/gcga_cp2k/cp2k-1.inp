@SET PROJ stage1
@SET CHG 0
@SET MULT 1
@SET SCFMODE DIAG
@SET ADDMOS 81
# Stage 1 / 3 : cheap rationalisation (loose SCF and forces, few steps)
# Reference style: PBE-D3(BJ), MOLOPT-SR-GTH. SCF block chosen by @SET SCFMODE (input.py scf_mode):
#   DIAG = diagonalization + Fermi-Dirac 300 K + ADDED_MOS (Multiwfn smearing reference) -> metals (default)
#   OT   = orbital transformation + OUTER_SCF (the group's MoS2/water reference) -> gapped systems only.
#   Ibex test 2026-09-22 on the Cu144 slab: OT 'converged' to minimizer-dependent states 0.20-0.62 eV above
#   the smeared result and 2-3x slower, so never use OT for metals.
# UKS + MULTIPLICITY 2 and 'ADDED_MOS n n' are switched in for odd electron counts (@SET MULT, as Multiwfn does).
&GLOBAL
  PROJECT ${PROJ}
  PRINT_LEVEL LOW
  RUN_TYPE GEO_OPT
  EXTENDED_FFT_LENGTHS
&END GLOBAL
&MOTION
  &GEO_OPT
    OPTIMIZER LBFGS
    MAX_ITER 40
    MAX_FORCE 3.0E-3
    RMS_FORCE 2.0E-3
    MAX_DR 5.0E-2
    RMS_DR 3.0E-2
  &END GEO_OPT
  &CONSTRAINT
    @INCLUDE constraint.inc
  &END CONSTRAINT
  &PRINT
    &TRAJECTORY
      FORMAT XYZ
    &END TRAJECTORY
    &RESTART OFF
    &END RESTART
    &RESTART_HISTORY OFF
    &END RESTART_HISTORY
  &END PRINT
&END MOTION
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    CHARGE ${CHG}
@IF ${MULT} == 2
    UKS
    MULTIPLICITY 2
@ENDIF
    &QS
      EPS_DEFAULT 1.0E-10
      EXTRAPOLATION ASPC
      EXTRAPOLATION_ORDER 3
    &END QS
    &POISSON
      PERIODIC XYZ
      PSOLVER PERIODIC
    &END POISSON
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          PARAMETER_FILE_NAME dftd3.dat
          TYPE DFTD3(BJ)
          REFERENCE_FUNCTIONAL PBE
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
    &MGRID
      CUTOFF 400
      REL_CUTOFF 40
    &END MGRID
@IF ${SCFMODE} == OT
    &SCF
      MAX_SCF 25
      EPS_SCF 1.0E-4
      SCF_GUESS atomic
      &OT
        PRECONDITIONER FULL_KINETIC
        MINIMIZER DIIS
        LINESEARCH 2PNT
        ALGORITHM STRICT
      &END OT
      &OUTER_SCF
        MAX_SCF 20
        EPS_SCF 1.0E-4
      &END OUTER_SCF
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
@ENDIF
@IF ${SCFMODE} == DIAG
    &SCF
      MAX_SCF 128
      EPS_SCF 1.0E-4
      SCF_GUESS atomic
      ADDED_MOS ${ADDMOS}
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.4
        NBROYDEN 8
      &END MIXING
      &SMEAR
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
@ENDIF
  &END DFT
  &SUBSYS
    &CELL
      @INCLUDE cell.inc
      PERIODIC XYZ
    &END CELL
    &COORD
      @INCLUDE coord.inc
    &END COORD
    @INCLUDE kind.inc
  &END SUBSYS
&END FORCE_EVAL
