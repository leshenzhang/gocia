# Stage 1/3 (cheap): force < 0.5 eV/A, max 25 steps, 250/40 Ry, EPS_SCF 1e-4
@SET PROJ stage1
@SET CHG 0
@SET MULT 1
@SET ADDMOS 81
&GLOBAL
  PROJECT ${PROJ}
  RUN_TYPE GEO_OPT
  PRINT_LEVEL LOW
&END GLOBAL
&MOTION
  &GEO_OPT
    OPTIMIZER BFGS
    MAX_ITER 25
    MAX_FORCE 9.723E-03
    RMS_FORCE 9.723E-03
    MAX_DR 1
    RMS_DR 1
    &BFGS
      &RESTART OFF
      &END RESTART
    &END BFGS
  &END GEO_OPT
  &CONSTRAINT
    @INCLUDE constraint.inc
  &END CONSTRAINT
  &PRINT
    &TRAJECTORY OFF
    &END TRAJECTORY
    &FINAL_STRUCTURE
      PRINT_CIF F
    &END FINAL_STRUCTURE
    &RESTART OFF
    &END RESTART
    &RESTART_HISTORY OFF
    &END RESTART_HISTORY
  &END PRINT
&END MOTION
&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    CHARGE ${CHG}
@IF ${MULT} == 2
    UKS
    MULTIPLICITY 2
@ENDIF
    &QS
      EPS_DEFAULT 1.0E-11
    &END QS
    &MGRID
      CUTOFF 250
      REL_CUTOFF 40
    &END MGRID
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &SCF
      MAX_SCF 128
      EPS_SCF 1.0E-4
      ADDED_MOS ${ADDMOS}
      &DIAGONALIZATION
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.4
        NBROYDEN 8
      &END MIXING
      &SMEAR
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE 300
      &END SMEAR
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
  &END DFT
  &SUBSYS
    &CELL
      @INCLUDE cell.inc
    &END CELL
    &COORD
      @INCLUDE coord.inc
    &END COORD
    @INCLUDE kind.inc
  &END SUBSYS
&END FORCE_EVAL
