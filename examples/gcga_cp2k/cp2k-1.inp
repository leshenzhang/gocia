@SET PROJ stage1
@SET CHG 0
@SET MULT 1
# Stage 1 / 3 : cheap rationalisation (loose SCF and forces, few steps)
# Reference style: PBE-D3(BJ), MOLOPT-SR-GTH, OT + OUTER_SCF, UKS with MULTIPLICITY set per structure
# (gocia.utils.cp2k writes @SET MULT from the valence-electron parity). Metals: replace &OT by
# &DIAGONALIZATION + &SMEAR FERMI_DIRAC + ADDED_MOS and drop UKS/MULTIPLICITY (see cp2k-gce.inp).
&GLOBAL
  PROJECT ${PROJ}
  PRINT_LEVEL LOW
  RUN_TYPE GEO_OPT
  EXTENDED_FFT_LENGTHS
&END GLOBAL
&MOTION
  &GEO_OPT
    OPTIMIZER LBFGS
    MAX_ITER 40
    MAX_FORCE 3.0E-3
    RMS_FORCE 2.0E-3
    MAX_DR 5.0E-2
    RMS_DR 3.0E-2
  &END GEO_OPT
  &CONSTRAINT
    @INCLUDE constraint.inc
  &END CONSTRAINT
  &PRINT
    &TRAJECTORY
      FORMAT XYZ
    &END TRAJECTORY
    &RESTART OFF
    &END RESTART
    &RESTART_HISTORY OFF
    &END RESTART_HISTORY
  &END PRINT
&END MOTION
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    CHARGE ${CHG}
    UKS
    MULTIPLICITY ${MULT}
    &QS
      EPS_DEFAULT 1.0E-10
      EXTRAPOLATION ASPC
      EXTRAPOLATION_ORDER 3
    &END QS
    &POISSON
      PERIODIC XYZ
      PSOLVER PERIODIC
    &END POISSON
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          PARAMETER_FILE_NAME dftd3.dat
          TYPE DFTD3(BJ)
          REFERENCE_FUNCTIONAL PBE
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
    &MGRID
      CUTOFF 400
      REL_CUTOFF 40
    &END MGRID
    &SCF
      MAX_SCF 25
      EPS_SCF 1.0E-4
      SCF_GUESS atomic
      &OT
        PRECONDITIONER FULL_KINETIC
        MINIMIZER DIIS
        LINESEARCH 2PNT
        ALGORITHM STRICT
      &END OT
      &OUTER_SCF
        MAX_SCF 20
        EPS_SCF 1.0E-4
      &END OUTER_SCF
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
  &END DFT
  &SUBSYS
    &CELL
      @INCLUDE cell.inc
      PERIODIC XYZ
    &END CELL
    &COORD
      @INCLUDE coord.inc
    &END COORD
    @INCLUDE kind.inc
  &END SUBSYS
&END FORCE_EVAL
