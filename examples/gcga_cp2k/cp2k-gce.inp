@SET PROJ gce
@SET CHG 0
@SET USHE 0.0
@SET PHISHE 4.43
@SET LPB 3.04
@SET NC 0.0025
# Route B: GEO_OPT at constant electrode potential USHE (V vs SHE) with the implicit electrolyte.
# Needs the ai-cp2k-lpb CP2K build (DEBYE_LENGTH, &GCE UPDATE_SCHEME CAPACITANCE). Slab must be z-symmetrised.
# Parse: gocia.utils.cp2k.gce_result -> Omega_el(U) = E - E_F*N_e from the last "GCE| trace" line.
&GLOBAL
  PRINT_LEVEL low
  PROJECT ${PROJ}
  RUN_TYPE GEO_OPT
  EXTENDED_FFT_LENGTHS
&END GLOBAL
&MOTION
  &GEO_OPT
    OPTIMIZER LBFGS
    MAX_ITER 200
    MAX_FORCE 4.5E-4
    RMS_FORCE 3.0E-4
    MAX_DR 3.0E-3
    RMS_DR 1.5E-3
  &END GEO_OPT
  &CONSTRAINT
    @INCLUDE constraint.inc
  &END CONSTRAINT
  &PRINT
    &TRAJECTORY
      FORMAT XYZ
    &END TRAJECTORY
    &RESTART off
    &END RESTART
    &RESTART_HISTORY off
    &END RESTART_HISTORY
  &END PRINT
&END MOTION
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    CHARGE ${CHG}
    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
      NGRIDS 5
    &END MGRID
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &QS
      EPS_DEFAULT 1.0E-10
      EXTRAPOLATION ASPC
    &END QS
    &SCCS on
      ALPHA [N*m^-1] 0.0
      BETA [kbar] 0.0
      GAMMA [mN/m] 0.0
      DELTA_RHO 2.0E-5
      DERIVATIVE_METHOD fft
      DIELECTRIC_CONSTANT 78.36
      EPS_SCCS 1.0E-6
      EPS_SCF 0.5
      MAX_ITER 200
      METHOD ISODENSITY
      MIXING 0.6
      SOLVER NEWTON_CG
      EPS_NLPB 1.0E-9
      MAX_ITER_NLPB 50
      DEBYE_LENGTH [angstrom] ${LPB}
      &ISODENSITY
        RHO_CAVITY [angstrom^-3] ${NC}
        SWITCH_WIDTH 0.6
      &END ISODENSITY
    &END SCCS
    &SCF
      EPS_SCF 1.0E-6
      MAX_SCF 600
      SCF_GUESS atomic
      ADDED_MOS 80
      &DIAGONALIZATION on
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &SMEAR on
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.2
        NBROYDEN 8
      &END MIXING
      &GCE on
        UPDATE_SCHEME CAPACITANCE
        UPDATE_EVERY SCF_CYCLE
        TARGET_POTENTIAL [eV] ${USHE}
        PHI_SHE [eV] ${PHISHE}
        FERMI_TOL [eV] 0.01
        MAX_OUTER_UPDATES 20
        UPDATE_INTERVAL 1
      &END GCE
      &PRINT
        &RESTART off
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      @INCLUDE cell.inc
      PERIODIC XYZ
    &END CELL
    &COORD
      @INCLUDE coord.inc
    &END COORD
    &KIND Pt
      BASIS_SET DZVP-MOLOPT-SR-GTH-q18
      POTENTIAL GTH-PBE-q18
    &END KIND
    &KIND Cu
      BASIS_SET DZVP-MOLOPT-SR-GTH-q11
      POTENTIAL GTH-PBE-q11
    &END KIND
    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH-q1
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND C
      BASIS_SET DZVP-MOLOPT-SR-GTH-q4
      POTENTIAL GTH-PBE-q4
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH-q6
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
