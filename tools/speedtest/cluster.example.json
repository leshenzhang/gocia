{
  "_comment": "Copy to cluster.json and fill in. {name} {ntasks} {walltime} {output} are filled per job. Never request a whole node on a shared cluster unless you mean to.",
  "header": [
    "#!/bin/bash",
    "#SBATCH --job-name={name}",
    "#SBATCH --nodes=1",
    "#SBATCH --ntasks={ntasks}",
    "#SBATCH --cpus-per-task=1",
    "#SBATCH --hint=nomultithread",
    "#SBATCH --mem-per-cpu=3G",
    "#SBATCH --time={walltime}",
    "#SBATCH --output={output}",
    "#SBATCH --partition=REPLACE_PARTITION",
    "#SBATCH --constraint=REPLACE_NODE_FEATURE"
  ],
  "setup": [
    "module purge",
    "module load REPLACE_COMPILER REPLACE_MPI REPLACE_MKL",
    "export MKL_NUM_THREADS=1",
    "ulimit -s unlimited"
  ],
  "mpi": "mpirun -np {np}",
  "walltime": "04:00:00",
  "cp2k": {
    "exe": "/REPLACE/cp2k/bin/cp2k.psmp",
    "env": "CP2K_DATA_DIR=/REPLACE/cp2k/data LD_LIBRARY_PATH=/REPLACE/cp2k/lib:$LD_LIBRARY_PATH"
  },
  "vasp": {
    "exe": "/REPLACE/vasp/bin/vasp_gam",
    "env": "",
    "potcar_dir": "/REPLACE/potpaw_PBE"
  }
}
